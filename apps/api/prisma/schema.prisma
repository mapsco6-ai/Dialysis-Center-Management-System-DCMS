// Phase 0 (Foundation) schema: Users, Roles, Permissions, Audit.
// Later phases append their own models here (Patient, DialysisSession, ...)
// without touching what's already defined, per docs/PROJECT-PHASES-PLAN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  fullName     String
  // Quick-PIN for identifying the actual performer on a shared/logged-in
  // device (docs/PROJECT-PHASES-PLAN.md Phase 7: "Username+Password أو PIN
  // سريع بعد الدخول الأساسي"). Hashed exactly like passwordHash - never
  // stored or compared in plaintext.
  pinHash      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Bumped on logout (and could be bumped on deactivation/password reset) so
  // every JWT issued before that moment is rejected immediately by
  // JwtStrategy, instead of staying valid until its natural expiry.
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles                 UserRole[]
  auditLogs             AuditLog[]
  clinicalAlerts        ClinicalAlert[]
  timelineEvents        PatientTimelineEvent[]
  requestedSchedules    DialysisSchedule[]            @relation("ScheduleRequestedByDoctor")
  checkedInSchedules    DialysisSchedule[]            @relation("ScheduleCheckedInBy")
  stockMovements        StockMovement[]
  supplyOverrides       SessionSupplyOverride[]
  supplyIssues          SessionSupplyIssueItem[]
  machineStatusChanges  MachineStatusHistory[]
  approvalsRequested    MachineUsageApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided      MachineUsageApprovalRequest[] @relation("ApprovalDecidedBy")
  nursedSessions        DialysisSession[]             @relation("SessionNurse")
  enteredReadings       DialysisReading[]
  recordedEvents        DialysisEvent[]
  nursingAssignments    NursingAssignment[]           @relation("AssignedNurse")
  assignmentsCreated    NursingAssignment[]           @relation("AssignmentCreatedBy")
  doctorOrders          DoctorOrder[]
  prescriptions         Prescription[]
  medicationsGiven      MedicationAdministration[]
  clinicalNotes         ClinicalNote[]
  labOrdersRequested    LabOrder[]
  labResultsEntered     LabResult[]
  prescriptionDispenses PrescriptionDispense[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Append-only. No update/delete path is exposed anywhere in the API on purpose
// (docs/MODULES-SPEC.md: "غير قابل للتعديل أو الحذف من أي واجهة").
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  device     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 1 (Patient Registry): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  TRANSFERRED
}

enum VascularAccessType {
  FISTULA
  CATHETER
  GRAFT
}

enum AlertSeverity {
  CRITICAL
  IMPORTANT
  INFORMATION
}

model Patient {
  id String @id @default(uuid())

  // humanNumber is a DB-level auto-incrementing sequence used only to derive
  // patientCode (e.g. P-000352) with zero collision risk under bulk import,
  // even across many concurrent inserts. It is never shown to end users.
  humanNumber Int    @unique @default(autoincrement())
  patientCode String @unique
  barcode     String @unique

  fullName    String
  gender      Gender
  dateOfBirth DateTime

  phone      String?
  address    String?
  fileNumber String?

  registeredAt DateTime      @default(now())
  status       PatientStatus @default(ACTIVE)

  dialysisStartDate      DateTime?
  dryWeight              Decimal?            @db.Decimal(5, 2)
  vascularAccessType     VascularAccessType?
  vascularAccessLocation String?

  diagnoses           String?
  chronicDiseases     Json?
  allergies           String?
  medicalNotes        String?
  specialInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts             ClinicalAlert[]
  timelineEvents     PatientTimelineEvent[]
  dialysisPlans      DialysisPlan[]
  dialysisSchedules  DialysisSchedule[]
  supplyProfiles     PatientSupplyProfile[]
  approvalRequests   MachineUsageApprovalRequest[]
  dialysisSessions   DialysisSession[]
  nursingAssignments NursingAssignmentPatient[]
  doctorOrders       DoctorOrder[]
  prescriptions      Prescription[]
  clinicalNotes      ClinicalNote[]
  labOrders          LabOrder[]

  @@index([fullName])
  @@index([fileNumber])
  @@index([phone])
  @@map("patients")
}

// Never deleted. A new alert logically supersedes an old one; the old one is
// closed via resolvedAt but stays in the record (docs/MODULES-SPEC.md).
model ClinicalAlert {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  severity AlertSeverity
  category String
  message  String

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([patientId])
  @@map("clinical_alerts")
}

// Append-only spine every module writes to (docs/PROJECT-PHASES-PLAN.md
// philosophy #1: "المريض هو المحور"). No update/delete path is ever exposed.
model PatientTimelineEvent {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type    String
  payload Json?

  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  performedAt   DateTime @default(now())

  sourceModule String

  @@index([patientId, performedAt])
  @@map("patient_timeline_events")
}

// ---------------------------------------------------------------------------
// Phase 2 (Scheduling): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

enum ShiftName {
  SHIFT_1
  SHIFT_2
  SHIFT_3
  SHIFT_4
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum ScheduleStatus {
  SCHEDULED
  ARRIVED
  LATE
  ABSENT
  CANCELLED
  EXTRA
  EMERGENCY
}

enum ScheduleType {
  REGULAR
  EXTRA
  EMERGENCY
}

// Fixed, seeded data (docs/MODULES-SPEC.md: "بيانات ثابتة وليست قابلة للتعديل
// اليومي من المستخدم العادي"). nominalCapacity/reservedCapacity are the only
// mutable fields in this phase - a manually-entered stand-in for real machine
// counts until Phase 5 wires this up to actual Machine records.
model Shift {
  id String @id @default(uuid())

  name          ShiftName @unique
  dialysisStart String // "HH:MM", 24h
  dialysisEnd   String
  cleaningStart String
  cleaningEnd   String

  nominalCapacity  Int @default(0)
  reservedCapacity Int @default(0)

  // Admin-configured per docs/MODULES-SPEC.md Phase 3 ("حد زمني تحدده
  // الإدارة"): a check-in later than this many minutes after dialysisStart
  // is marked LATE instead of ARRIVED.
  lateThresholdMinutes Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans              DialysisPlan[]
  schedules          DialysisSchedule[]
  nursingAssignments NursingAssignment[]

  @@map("shifts")
}

// The patient's standing weekly plan (1-4 sessions/week). Setting a new plan
// closes out the previous entries (isActive=false, effectiveTo=now) instead
// of deleting them, per the append-or-amend rule.
model DialysisPlan {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  weekday Weekday
  shiftId String
  shift   Shift   @relation(fields: [shiftId], references: [id])

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules DialysisSchedule[]

  @@index([patientId])
  @@map("dialysis_plans")
}

// The materialized daily schedule. REGULAR rows are generated on demand from
// active DialysisPlans the first time a given date is queried (see
// SchedulingService.ensureGenerated) rather than by a wall-clock cron job -
// simpler than standing up job infrastructure this early, and behaves
// identically from the API's point of view. EXTRA/EMERGENCY rows are created
// directly by staff/doctor request and are never auto-generated.
model DialysisSchedule {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  planId String?
  plan   DialysisPlan? @relation(fields: [planId], references: [id])

  scheduledDate DateTime @db.Date
  shiftId       String
  shift         Shift    @relation(fields: [shiftId], references: [id])

  // Lifecycle stage, independent of `type` (which just tags *why* the row
  // exists). Every row - REGULAR, EXTRA, or EMERGENCY alike - starts
  // SCHEDULED and moves through the same ARRIVED/LATE/ABSENT lifecycle
  // (docs/PROJECT-PHASES-PLAN.md Phase 3).
  status ScheduleStatus @default(SCHEDULED)
  type   ScheduleType   @default(REGULAR)

  extraReason         String?
  requestedByDoctorId String?
  requestedByDoctor   User?   @relation("ScheduleRequestedByDoctor", fields: [requestedByDoctorId], references: [id])

  emergencySourceHospital String?
  emergencyReason         String?

  // Phase 3 (Reception): docs/MODULES-SPEC.md - added to DialysisSchedule
  // rather than a new model.
  checkInTime      DateTime?
  checkInByUserId  String?
  checkInByUser    User?     @relation("ScheduleCheckedInBy", fields: [checkInByUserId], references: [id])
  checkInStationId String?
  lateMinutes      Int?
  // Set only by the automatic (not manual) absence check - see
  // SchedulingService.ensureAbsencesMarked. Kept even if the patient later
  // shows up and checks in late, as a historical fact (append-or-amend).
  absentMarkedAt   DateTime?

  // Phase 5 (Machines): set by MachinesService.assignMachine, never directly.
  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplyOverrides  SessionSupplyOverride[]
  supplyIssueItems SessionSupplyIssueItem[]
  stockMovements   StockMovement[]
  approvalRequests MachineUsageApprovalRequest[]
  // Phase 6: the actual clinical session that branches off this schedule
  // once the patient arrives (docs/MODULES-SPEC.md: "DialysisSchedule هو
  // الأصل الذي تتفرع منه لاحقاً DialysisSession"). At most one per schedule.
  session          DialysisSession?

  @@unique([patientId, scheduledDate, shiftId])
  @@index([scheduledDate])
  @@map("dialysis_schedules")
}

// ---------------------------------------------------------------------------
// Phase 4 (Inventory Supplies): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

enum StockLocationType {
  MAIN_WAREHOUSE
  PHARMACY
  LABORATORY_STOCK
  WARD_STOCK
}

enum StockMovementType {
  ISSUE
  TRANSFER
  ADJUSTMENT
}

// UNAVAILABLE is never silently replaced - a shortage is a fact on the
// record; a substitute is a separate ISSUED-like row referencing it via
// substituteForItemId, not an edit to this one (docs/MODULES-SPEC.md
// Phase 4: "لا استبدال صامت").
enum SupplyIssueStatus {
  ISSUED
  UNAVAILABLE
  SUBSTITUTED
}

model InventoryItem {
  id String @id @default(uuid())

  name     String
  category String
  unit     String
  barcode  String? @unique

  // Used by later phases (Low/Critical Stock alerts in Phase 11, session
  // cost in Phase 11/14) - stored now since they're intrinsic properties of
  // the catalog item, not because this phase computes alerts or costs.
  minimumStock          Decimal @default(0) @db.Decimal(10, 2)
  cost                  Decimal @default(0) @db.Decimal(10, 2)
  requiresBatchTracking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances                StockBalance[]
  movements               StockMovement[]
  supplyProfiles          PatientSupplyProfile[]
  sessionOverrides        SessionSupplyOverride[]
  issueItems              SessionSupplyIssueItem[] @relation("IssueItem")
  substitutedForIssueRows SessionSupplyIssueItem[] @relation("SubstituteItem")
  prescriptionDispenses   PrescriptionDispense[]

  @@index([category])
  @@map("inventory_items")
}

// Fixed reference data like Shift - MAIN_WAREHOUSE is the only one seeded
// and used before Phase 10/11 introduce the others.
model StockLocation {
  id   String            @id @default(uuid())
  type StockLocationType @unique
  name String?

  createdAt DateTime @default(now())

  balances      StockBalance[]
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")

  @@map("stock_locations")
}

model StockBalance {
  id String @id @default(uuid())

  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])

  // Never allowed to go negative - enforced by a conditional update in
  // InventoryItemsService, not just application-level intent (docs/MODULES-SPEC.md).
  quantity Decimal @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  @@unique([itemId, locationId])
  @@map("stock_balances")
}

// Append-only ledger - the audit trail for "where did this stock go/come
// from" independent of AuditLog, since AuditLog isn't meant to be queried
// for quantity math (docs/MODULES-SPEC.md).
model StockMovement {
  id String @id @default(uuid())

  itemId         String
  item           InventoryItem  @relation(fields: [itemId], references: [id])
  fromLocationId String?
  fromLocation   StockLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     StockLocation? @relation("MovementTo", fields: [toLocationId], references: [id])

  quantity     Decimal           @db.Decimal(10, 2)
  movementType StockMovementType
  reason       String?

  relatedScheduleId String?
  relatedSchedule   DialysisSchedule? @relation(fields: [relatedScheduleId], references: [id])

  // Set for a Phase 10 pharmacy dispense - same traceability role as
  // relatedScheduleId, just for the movement's other common trigger.
  relatedPrescriptionId String?
  relatedPrescription   Prescription? @relation(fields: [relatedPrescriptionId], references: [id])

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([relatedScheduleId])
  @@index([relatedPrescriptionId])
  @@map("stock_movements")
}

// The patient's standing default supplies (dialyzer type, blood line, needle
// gauge, saline...). Plain current-state config (like Shift capacity), not
// versioned history like DialysisPlan - MODULES-SPEC describes it as just
// "المواد الافتراضية لكل مريض" with no effective-dating requirement.
model PatientSupplyProfile {
  id String @id @default(uuid())

  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])

  defaultQuantity Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, itemId])
  @@map("patient_supply_profiles")
}

// A one-session-only change to what's issued, without touching the patient's
// default profile (docs/MODULES-SPEC.md Phase 4 acceptance criterion 2).
model SessionSupplyOverride {
  id String @id @default(uuid())

  scheduleId String
  schedule   DialysisSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem    @relation(fields: [itemId], references: [id])

  overrideQuantity Decimal @db.Decimal(10, 2)
  reason           String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, itemId])
  @@map("session_supply_overrides")
}

// The actual record of what was (or wasn't) given for a session - what
// "confirm issue" writes. Queryable per session for cost/history purposes
// (acceptance criterion 7: "ما هي المواد التي صُرفت لهذه الجلسة؟").
model SessionSupplyIssueItem {
  id String @id @default(uuid())

  scheduleId String
  schedule   DialysisSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem    @relation("IssueItem", fields: [itemId], references: [id])

  quantityRequested Decimal           @db.Decimal(10, 2)
  quantityIssued    Decimal           @default(0) @db.Decimal(10, 2)
  status            SupplyIssueStatus

  substituteForItemId String?
  substituteForItem   InventoryItem? @relation("SubstituteItem", fields: [substituteForItemId], references: [id])
  reason              String?

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([scheduleId, itemId])
  // DB-level guard against two concurrent substitute requests both covering
  // the same shortage (docs review DCMS-044) - Postgres treats multiple NULLs
  // here as distinct, so ordinary (non-substitute) issue rows are unaffected.
  @@unique([scheduleId, substituteForItemId])
  @@index([scheduleId])
  @@map("session_supply_issue_items")
}

// ---------------------------------------------------------------------------
// Phase 5 (Machines): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

enum MachineStatus {
  AVAILABLE
  IN_USE
  RESERVED
  EMERGENCY_RESERVED
  APPROVAL_REQUIRED
  WAITING_CLEANING
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// Deliberately NOT seeded (unlike Shift/StockLocation): a ward's name/count
// is a fact about the real physical center, not something this codebase
// should invent. Created via the API by an admin, same reasoning as
// InventoryItem.
model Ward {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machines           Machine[]
  dialysisSessions   DialysisSession[]
  nursingAssignments NursingAssignment[]

  @@map("wards")
}

// Never deleted - only OUT_OF_SERVICE (docs/MODULES-SPEC.md). Every status
// transition must go through MachinesService.setStatus /
// MachinesService.assignMachine, never a direct Prisma update from another
// module, so MachineStatusHistory can never miss an entry.
model Machine {
  id          String @id @default(uuid())
  machineCode String @unique

  wardId String
  ward   Ward   @relation(fields: [wardId], references: [id])

  serialNumber String?
  manufacturer String?
  model        String?

  status MachineStatus @default(AVAILABLE)

  // A machine kept out of the normal assignment pool - either permanently
  // for emergencies, or generally protected - until an authorized decision
  // (approval, or a manual override by someone with that same authority)
  // lets it be used for an ordinary patient (docs/MODULES-SPEC.md).
  isEmergencyDedicated Boolean @default(false)
  isProtected          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory    MachineStatusHistory[]
  approvalRequests MachineUsageApprovalRequest[]
  schedules        DialysisSchedule[]
  dialysisSessions DialysisSession[]

  @@map("machines")
}

// Append-only - this *is* the Machine Timeline referenced elsewhere in the
// docs (fully built out in Phase 12).
model MachineStatusHistory {
  id String @id @default(uuid())

  machineId  String
  machine    Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  fromStatus MachineStatus
  toStatus   MachineStatus

  changedById String
  changedBy   User    @relation(fields: [changedById], references: [id])
  reason      String?

  changedAt DateTime @default(now())

  @@index([machineId, changedAt])
  @@map("machine_status_history")
}

// Anchored to a specific DialysisSchedule row (not just a recurring
// patient+machine+shift pairing) - precise enough that "duplicate request for
// the same patient/machine/shift updates instead of creating a new one"
// (docs/MODULES-SPEC.md) holds for the same session by construction, without
// conflating different calendar days that merely share a shift.
model MachineUsageApprovalRequest {
  id String @id @default(uuid())

  patientId  String
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  machineId  String
  machine    Machine          @relation(fields: [machineId], references: [id])
  scheduleId String
  schedule   DialysisSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  reason String

  requestedById String
  requestedBy   User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])

  decision    ApprovalDecision @default(PENDING)
  decidedById String?
  decidedBy   User?            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([patientId, machineId, scheduleId])
  @@map("machine_usage_approval_requests")
}

// ---------------------------------------------------------------------------
// Phase 6 (Dialysis Session): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

// The full clinical state machine. SCHEDULED/ARRIVED/LATE/ABSENT/CANCELLED
// live entirely on DialysisSchedule (Phase 3) - a DialysisSession row is only
// ever created once the patient has arrived and Pre-Dialysis begins, so this
// enum starts there.
enum DialysisSessionStatus {
  PRE_DIALYSIS
  SUPPLIES_READY
  WAITING_MACHINE
  ASSIGNED
  IN_DIALYSIS
  POST_DIALYSIS
  COMPLETED
  DISCHARGED
  INTERRUPTED
}

enum DialysisEventType {
  NORMAL
  HYPOTENSION
  ACCESS_ISSUE
  MACHINE_ISSUE
  MEDICATION_GIVEN
  PHYSICIAN_CALLED
  SESSION_INTERRUPTED
  OTHER
}

// One row per DialysisSchedule, created lazily on the first Pre-Dialysis
// call (docs/MODULES-SPEC.md: "DialysisSchedule هو الأصل الذي تتفرع منه
// لاحقاً DialysisSession"). All state transitions go through
// SessionsService.transition() - never a direct Prisma update - so the
// ordering guard ("لا يمكن تخطي مرحلة") can never be bypassed.
model DialysisSession {
  id String @id @default(uuid())

  scheduleId String           @unique
  schedule   DialysisSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Set once the machine-assignment flow (Phase 5) resolves for this
  // session, and re-pointed by REASSIGN MACHINE mid-session without ever
  // losing the readings/events collected so far.
  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])
  wardId    String?
  ward      Ward?    @relation(fields: [wardId], references: [id])

  nurseId String?
  nurse   User?   @relation("SessionNurse", fields: [nurseId], references: [id])

  status DialysisSessionStatus @default(PRE_DIALYSIS)

  // Pre-Dialysis assessment (docs: "Weight/BP/Pulse/Temperature/Glucose/Dry
  // Weight/Notes"), captured once on arrival and required (non-null) before
  // START DIALYSIS can proceed.
  preWeight      Decimal? @db.Decimal(5, 2)
  preBP          String?
  prePulse       Int?
  preTemperature Decimal? @db.Decimal(4, 1)
  preGlucose     Decimal? @db.Decimal(6, 2)
  dryWeight      Decimal? @db.Decimal(5, 2)
  preNotes       String?

  // START DIALYSIS (docs: "Ward/Machine/Start Time/Nurse/Pre Weight/BP/
  // Pulse/Dialyzer/Prescribed Duration/Required UF/Access Info" - Ward,
  // Machine and Pre Weight/BP/Pulse are the fields above, already captured).
  dialyzerType              String?
  bloodLineType             String?
  prescribedDurationMinutes Int?
  requiredUF                Decimal?  @db.Decimal(6, 2)
  accessInfo                Json?
  startTime                 DateTime?

  // END DIALYSIS
  postWeight            Decimal?  @db.Decimal(5, 2)
  postBP                String?
  postPulse             Int?
  actualUF              Decimal?  @db.Decimal(6, 2)
  actualDurationMinutes Int?
  complications         String?
  finalNote             String?
  endTime               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings              DialysisReading[]
  events                DialysisEvent[]
  linkedPrescriptions   Prescription[]
  medicationsGiven      MedicationAdministration[]
  clinicalNotes         ClinicalNote[]
  prescriptionDispenses PrescriptionDispense[]

  @@map("dialysis_sessions")
}

// Append-or-Amend (docs/MODULES-SPEC.md: "لا UPDATE مباشر على قراءة موجودة -
// التعديل ينشئ سجلاً جديداً بـamendedFromId"). A reading is never mutated in
// place; amending creates a new row pointing back at the one it corrects.
model DialysisReading {
  id String @id @default(uuid())

  sessionId String
  session   DialysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  time             DateTime @default(now())
  bp               String?
  pulse            Int?
  arterialPressure Decimal? @db.Decimal(6, 2)
  venousPressure   Decimal? @db.Decimal(6, 2)
  tmp              Decimal? @db.Decimal(6, 2)
  bloodFlow        Decimal? @db.Decimal(6, 2)
  uf               Decimal? @db.Decimal(6, 2)

  enteredById String
  enteredBy   User   @relation(fields: [enteredById], references: [id])

  amendedFromId String?
  amendedFrom   DialysisReading?  @relation("ReadingAmendment", fields: [amendedFromId], references: [id])
  amendments    DialysisReading[] @relation("ReadingAmendment")

  createdAt DateTime @default(now())

  @@index([sessionId, time])
  @@map("dialysis_readings")
}

// Append-only, never edited or deleted - this is what feeds both the
// session's own event log and the patient's Timeline immediately
// (docs/PROJECT-PHASES-PLAN.md Phase 6 acceptance criterion 4).
model DialysisEvent {
  id String @id @default(uuid())

  sessionId String
  session   DialysisSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      DialysisEventType
  note      String?

  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())

  @@index([sessionId, recordedAt])
  @@map("dialysis_events")
}

// ---------------------------------------------------------------------------
// Phase 7 (Nursing): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

// One row per nurse per ward/shift/date - the patients under them live in
// NursingAssignmentPatient rather than a JSON array so the "no conflict"
// rule (a patient can't sit under two nurses for the same ward/shift/date)
// is a real DB constraint, not just an application check
// (docs/MODULES-SPEC.md: "لا تعارض... إلا إذا سياسة المركز تسمح بذلك صراحة").
model NursingAssignment {
  id String @id @default(uuid())

  wardId  String
  ward    Ward     @relation(fields: [wardId], references: [id])
  shiftId String
  shift   Shift    @relation(fields: [shiftId], references: [id])
  date    DateTime @db.Date

  nurseId String
  nurse   User   @relation("AssignedNurse", fields: [nurseId], references: [id])

  createdById String
  createdBy   User   @relation("AssignmentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients NursingAssignmentPatient[]

  @@unique([wardId, shiftId, date, nurseId])
  @@index([nurseId, date])
  @@map("nursing_assignments")
}

model NursingAssignmentPatient {
  id String @id @default(uuid())

  assignmentId String
  assignment   NursingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Denormalized from the parent assignment: lets a single DB unique
  // constraint enforce "this patient belongs to at most one nurse for this
  // ward/shift/date" directly, without a cross-table check that could race.
  wardId  String
  shiftId String
  date    DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([patientId, wardId, shiftId, date])
  @@map("nursing_assignment_patients")
}

// ---------------------------------------------------------------------------
// Phase 8 (Doctor PWA): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

enum DoctorOrderType {
  MEDICATION
  LAB_REQUEST
  NURSING_INSTRUCTION
  DRY_WEIGHT_CHANGE
  EXTRA_SESSION_REQUEST
  PHARMACY_RECOMMENDATION
}

enum DoctorOrderStatus {
  ACTIVE
  MODIFIED
  STOPPED
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSING
  DISPENSED
  MODIFIED
  STOPPED
}

// Every doctor action - of any type - is one of these rows. Amending never
// deletes: STOP flips this same row's status in place (nothing to preserve
// two versions of), while MODIFY creates a new row (previousOrderId back to
// this one) and flips this row to MODIFIED, so the old payload (old dose,
// old instruction, ...) stays queryable forever (docs/MODULES-SPEC.md:
// "تعديل أمر طبي: لا حذف").
model DoctorOrder {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User    @relation(fields: [doctorId], references: [id])

  type    DoctorOrderType
  payload Json
  status  DoctorOrderStatus @default(ACTIVE)

  previousOrderId String?
  previousOrder   DoctorOrder?  @relation("OrderChain", fields: [previousOrderId], references: [id])
  nextOrders      DoctorOrder[] @relation("OrderChain")

  // Required by the service when status becomes STOPPED/MODIFIED - null at
  // creation, since ACTIVE needs no justification (docs/MODULES-SPEC.md:
  // "إلزامي عند STOPPED/MODIFIED").
  reason String?

  // Only set for type=MEDICATION - the Prescription this order created or
  // (after a MODIFY) now points to.
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@map("doctor_orders")
}

// The "Current Medications" projection - ACTIVE rows are current, STOPPED
// are discontinued, MODIFIED means a newer row (nextPrescription) replaced
// this one's dose/frequency/duration. DISPENSING/DISPENSED are Phase 10
// (Pharmacy) states, not set by anything in this phase.
model Prescription {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User    @relation(fields: [doctorId], references: [id])

  medicationName String
  dose           String
  frequency      String
  duration       String?

  linkedSessionId String?
  linkedSession   DialysisSession? @relation(fields: [linkedSessionId], references: [id])

  status PrescriptionStatus @default(ACTIVE)

  // @unique enforces a strictly linear chain - two concurrent modifications
  // of the same prescription can't both succeed (same atomic-guard
  // reasoning as the rest of this codebase).
  previousPrescriptionId String?       @unique
  previousPrescription   Prescription? @relation("PrescriptionChain", fields: [previousPrescriptionId], references: [id])
  nextPrescription       Prescription? @relation("PrescriptionChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders                DoctorOrder[]
  administrations       MedicationAdministration[]
  dispenses             PrescriptionDispense[]
  relatedStockMovements StockMovement[]

  @@map("prescriptions")
}

// Deliberately separate from Prescription (docs/MODULES-SPEC.md: "قاعدة
// Prescription ≠ Administration... لا حقل واحد isGiven boolean") - what the
// doctor ordered and what the patient actually received are always two
// distinct, independently-queryable facts.
model MedicationAdministration {
  id String @id @default(uuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  administeredById String
  administeredBy   User     @relation(fields: [administeredById], references: [id])
  administeredAt   DateTime @default(now())
  doseGiven        String

  sessionId String?
  session   DialysisSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())

  @@index([prescriptionId])
  @@map("medication_administrations")
}

model ClinicalNote {
  id String @id @default(uuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])

  sessionId String?
  session   DialysisSession? @relation(fields: [sessionId], references: [id])

  text      String
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

// ---------------------------------------------------------------------------
// Phase 9 (Laboratory): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// ---------------------------------------------------------------------------

// Deliberately NOT seeded (unlike Shift/StockLocation) - the real catalog of
// tests/reference ranges is a fact about the actual lab, not something this
// codebase should invent, same reasoning as InventoryItem/Ward.
model LabTest {
  id String @id @default(uuid())

  code String  @unique
  name String
  unit String?

  referenceRangeLow  Decimal? @db.Decimal(10, 3)
  referenceRangeHigh Decimal? @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panels     LabPanelTest[]
  orderItems LabOrderItem[]

  @@map("lab_tests")
}

// A configurable named group of tests (docs: "مثل Monthly Dialysis Panel")
// ordered together in one action.
model LabPanel {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests LabPanelTest[]

  @@map("lab_panels")
}

model LabPanelTest {
  labPanelId String
  labPanel   LabPanel @relation(fields: [labPanelId], references: [id], onDelete: Cascade)
  labTestId  String
  labTest    LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  @@id([labPanelId, labTestId])
  @@map("lab_panel_tests")
}

enum LabOrderItemStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_ENTERED
  FINAL
  AMENDED
  CANCELLED
}

// One LabOrder groups every item requested together, and episodeCode is
// what lets every result from the same request/date display as a single
// Lab Episode (docs/MODULES-SPEC.md: "يجمّع كل نتائج نفس الطلب/التاريخ").
model LabOrder {
  id String @id @default(uuid())

  // Same zero-collision-under-concurrency trick as Patient.patientCode: a
  // DB-level auto-incrementing sequence derives episodeCode, instead of
  // generating a "unique enough" code in application code.
  humanNumber Int    @unique @default(autoincrement())
  episodeCode String @unique

  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderedByDoctorId String
  orderedByDoctor   User     @relation(fields: [orderedByDoctorId], references: [id])
  orderedAt         DateTime @default(now())

  items LabOrderItem[]

  @@map("lab_orders")
}

model LabOrderItem {
  id String @id @default(uuid())

  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId  String
  labTest    LabTest  @relation(fields: [labTestId], references: [id])

  status LabOrderItemStatus @default(ORDERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results LabResult[]

  @@index([labOrderId])
  @@index([status])
  @@map("lab_order_items")
}

// Append-or-Amend, same rule as DialysisReading (docs/MODULES-SPEC.md: "لا
// اعتماد ثانٍ حالياً - من يُدخل النتيجة يجعلها Final مباشرة"... "تعديل نتيجة
// Final لا يستبدلها - ينشئ AMENDED جديدة"). A result is never mutated in
// place; amending creates a new row pointing back at the one it corrects.
model LabResult {
  id String @id @default(uuid())

  labOrderItemId String
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)

  value   String
  isFinal Boolean @default(true)

  enteredById String
  enteredBy   User   @relation(fields: [enteredById], references: [id])

  amendedFromId String?    @unique
  amendedFrom   LabResult? @relation("ResultAmendment", fields: [amendedFromId], references: [id])
  amendedTo     LabResult? @relation("ResultAmendment")
  // Required by the service when this row amends a previous one - null on
  // the very first (non-amendment) entry.
  amendReason   String?

  createdAt DateTime @default(now())

  @@index([labOrderItemId])
  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// Phase 10 (Pharmacy): docs/PROJECT-PHASES-PLAN.md + docs/MODULES-SPEC.md
// Reuses StockLocation(type=PHARMACY)/StockBalance/StockMovement from Phase 4
// as instructed ("لا تكرار للنموذج") - no new stock model here.
// ---------------------------------------------------------------------------

// itemId bridges Prescription's free-text medicationName (a doctor has no
// visibility into the inventory catalog) to the real InventoryItem whose
// PHARMACY StockBalance is actually decremented - not in MODULES-SPEC.md's
// minimal field list, but there is nothing to deduct stock from without it.
model PrescriptionDispense {
  id String @id @default(uuid())

  prescriptionId String
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])

  dispensedById String
  dispensedBy   User    @relation(fields: [dispensedById], references: [id])
  quantity      Decimal @db.Decimal(10, 2)

  linkedSessionId String?
  linkedSession   DialysisSession? @relation(fields: [linkedSessionId], references: [id])

  dispensedAt DateTime @default(now())

  @@index([prescriptionId])
  @@map("prescription_dispenses")
}
