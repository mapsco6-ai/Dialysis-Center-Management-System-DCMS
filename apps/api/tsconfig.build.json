{
  "extends": "./tsconfig.json",
  // The editor-facing tsconfig.json widens rootDir/include so it also
  // covers scripts/ and prisma/seed.ts (they import from src/ but aren't
  // meant to ship) - the real production build narrows both back to
  // exactly what ends up in dist/main.js, unchanged from before.
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
