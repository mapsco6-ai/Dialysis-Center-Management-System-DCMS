DATABASE_URL="postgresql://dcms:dcms@localhost:5432/dcms?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3001

SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# "Today" for scheduling means the center's local calendar day (see
# apps/api/src/scheduling/date.util.ts) - set this to wherever the center is.
TZ="Asia/Baghdad"

# MinIO (Phase 12: maintenance fault-report attachments) - all optional. An
# attachment is optional on a fault report (docs/PROJECT-PHASES-PLAN.md), and
# the whole maintenance flow works without ever configuring these; only the
# actual upload/download of a photo needs a reachable MinIO.
MINIO_ENDPOINT="localhost"
MINIO_PORT=19000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="dcms-maintenance"
