# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored on purpose - never commit real
# secrets. Generate strong values with: openssl rand -base64 48

# Postgres owner user - used by Prisma CLI (migrate/seed) and has full DDL
# rights. The running API server does NOT use this; it uses APP_DB_PASSWORD.
POSTGRES_PASSWORD=

# Restricted role the running API server actually connects as. Created by
# database/init/01-app-role.sh on first Postgres startup, then locked down
# further by apps/api/prisma/harden-db.sql after migrations run (see
# docs/TECHNICAL-REVIEW-ISSUES-AR.md DCMS-018).
APP_DB_PASSWORD=

# Signs and verifies every JWT. Must be >= 32 chars and never reused across
# environments (see apps/api/src/config/env.validation.ts).
JWT_SECRET=

# There is no default anymore (see docs review DCMS-002) - the API refuses to
# seed without this. >= 8 chars.
SUPER_ADMIN_PASSWORD=

SUPER_ADMIN_USERNAME=admin

# Host-facing Postgres port. Bound to 127.0.0.1 only (docker-compose.yml) -
# change the container-side 5432 only if you know what you're doing.
POSTGRES_HOST_PORT=15432

# MinIO (Phase 12: maintenance fault-report attachments). Generate strong
# values the same way as the other secrets above - there is no default.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host-facing MinIO console/API port. Bound to 127.0.0.1 only, same reasoning
# as POSTGRES_HOST_PORT - attachments are only ever fetched through the API's
# own GET /maintenance/tickets/:id/attachment, never directly from MinIO.
MINIO_HOST_PORT=19000

# The browser-facing API origin baked into the web build at build time
# (Next.js inlines NEXT_PUBLIC_* vars - changing this requires a rebuild).
# Leave this relative. The web app then calls the API on whatever host the
# browser opened it with, and API_PROXY_TARGET below forwards those calls on.
# An absolute URL here reintroduces DCMS-012: the browser treats a page on
# 127.0.0.1 (or a LAN address) and an API on localhost as different sites, so
# it silently drops the SameSite=Lax session cookie - login returns 200 and
# the app still behaves as signed out.
NEXT_PUBLIC_API_URL=/api/v2

# Where the web container forwards /api and /socket.io. The compose service
# name is right for docker compose; a hosted deployment points this at the
# API's internal hostname. Read at BUILD time (Next bakes rewrites into the
# routes manifest), so changing it also requires a rebuild.
API_PROXY_TARGET=http://api:3001
